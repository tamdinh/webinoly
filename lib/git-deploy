#!/bin/bash

# Ensure the script runs as root
if [ "$EUID" -ne 0 ]; then
  echo "[-] Please run this script as root or with sudo."
  exit 1
fi

ACTION=$1
DOMAIN=$2
GIT_URL=$3

# Display help if arguments are wrong
if [ -z "$ACTION" ] || [ -z "$DOMAIN" ]; then
  echo "[-] Error: Missing arguments."
  echo "Usage:"
  echo "  git-deploy connect <domain> <git@github.com:username/repo.git>"
  echo "  git-deploy pull <domain>"
  exit 1
fi

WEB_DIR="/var/www/${DOMAIN}/htdocs"

# =========================================================================
# COMMAND: PULL CODE (Manual Terminal Deployment)
# =========================================================================
if [ "$ACTION" == "pull" ]; then
    if [ ! -d "$WEB_DIR" ]; then
        echo "[-] Error: Web directory for ${DOMAIN} does not exist at ${WEB_DIR}."
        exit 1
    fi
    
    if [ ! -d "${WEB_DIR}/.git" ]; then
        echo "[-] Error: ${DOMAIN} is not initialized as a Git repository."
        exit 1
    fi
    
    echo "[+] Fetching and pulling latest updates for ${DOMAIN}..."
    cd "$WEB_DIR" || exit
    
    # Ensure the directory is marked as safe before executing pull
    git config --global --add safe.directory "$WEB_DIR"
    
    # Run git pull as root using the generated system SSH keys
    git pull
    
    if [ $? -eq 0 ]; then
        echo "[+] Git pull successful. Fixing permissions..."
        chown -R www-data:www-data "$WEB_DIR"
        chmod -R 755 "$WEB_DIR"
        echo "[SUCCESS] Website ${DOMAIN} has been updated!"
    else
        echo "[-] Error: Git pull failed."
    fi
    exit 0
fi

# =========================================================================
# COMMAND: CONNECT SITE (Initial Configuration Setup)
# =========================================================================
if [ "$ACTION" == "connect" ]; then
    if [ -z "$GIT_URL" ]; then
      echo "[-] Error: Missing Git URL for connect command."
      echo "Usage: git-deploy connect <domain> <git@github.com:username/repo.git>"
      exit 1
    fi

    # Ensure git is installed
    if ! command -v git &> /dev/null; then
        echo "[+] Git not found. Installing..."
        apt update && apt install git -y
    fi

    # Automatically handle SSH Deploy Key generation
    SSH_KEY_FILE="/root/.ssh/id_ed25519"
    if [ ! -f "$SSH_KEY_FILE" ]; then
        echo "[+] Generating an automated SSH Deploy Key for the server..."
        mkdir -p /root/.ssh
        chmod 700 /root/.ssh
        ssh-keygen -t ed25519 -N "" -f "$SSH_KEY_FILE" -C "deploy@${DOMAIN}"
    fi

    # Read the public key to print at the end
    PUBLIC_KEY=$(cat "${SSH_KEY_FILE}.pub")

    # Generate a secure random token for the webhook signature
    SECRET_TOKEN=$(head /dev/urandom | tr -dc A-Za-z0-9 | head -c 24)

    echo "[+] Step 1: Handling Webinoly Site Provisioning..."
    if [ -d "/var/www/${DOMAIN}" ]; then
        echo "[INFO] Site ${DOMAIN} already exists in Webinoly. Skipping site creation step."
    else
        echo "[+] Creating brand new PHP & MySQL site via Webinoly..."
        site "$DOMAIN" -php -mysql
        if [ $? -ne 0 ]; then
          echo "[-] Webinoly failed to create the site structure. Aborting setup."
          exit 1
        fi
    fi

    echo "[+] Step 2: Preparing web directories..."
    rm -rf "${WEB_DIR:?}"/*
    rm -rf "${WEB_DIR:?}"/.* 2>/dev/null

    echo "[+] Step 3: Cloning GitHub Repository into web directory..."
    # Whitelist directory in Git global config to bypass dubious ownership blocks
    git config --global --add safe.directory "$WEB_DIR"
    
    # Automatically skip host key verification prompt for github
    ssh-keyscan -t ed25519 github.com >> /root/.ssh/known_hosts 2>/dev/null
    git clone "$GIT_URL" "$WEB_DIR"

    if [ $? -ne 0 ]; then
      echo "-------------------------------------------------------------------------"
      echo "[-] INITIAL CLONE FAILED!"
      echo "This happens because GitHub doesn't know your server's key yet."
      echo "Please add the SSH Deploy Key below to GitHub, then run the command again."
      echo "-------------------------------------------------------------------------"
      echo "🔑 YOUR SSH DEPLOY KEY:"
      echo "$PUBLIC_KEY"
      echo "-------------------------------------------------------------------------"
      exit 1
    fi

    echo "[+] Step 4: Generating secure deploy.php automation webhook..."
    DEPLOY_SCRIPT="${WEB_DIR}/deploy.php"

    cat <<EOT > "$DEPLOY_SCRIPT"
<?php
\$secret = '$SECRET_TOKEN'; 

\$signature = \$_SERVER['HTTP_X_HUB_SIGNATURE_256'] ?? '';
if (!\$signature) {
    header('HTTP/1.1 403 Forbidden');
    die('Access denied: Missing signature.');
}

\$payload = file_get_contents('php://input');
\$expected_signature = 'sha256=' . hash_hmac('sha256', \$payload, \$secret);

if (hash_equals(\$expected_signature, \$signature)) {
    echo "Signature verified. Deploying updates for $DOMAIN...\n";
    
    // Register the safe directory dynamically for the www-data execution environment
    shell_exec('git config --global --add safe.directory $WEB_DIR');
    
    \$output = shell_exec('cd $WEB_DIR && git pull 2>&1');
    echo \$output;
    shell_exec('chown -R www-data:www-data $WEB_DIR');
} else {
    header('HTTP/1.1 403 Forbidden');
    die('Access denied: Invalid signature.');
}
?>
EOT

    echo "[+] Step 5: Finalizing server permissions..."
    chown -R www-data:www-data "/var/www/${DOMAIN}"

    echo "========================================================================="
    echo "[SUCCESS] Automation configuration successfully deployed for $DOMAIN!"
    echo "========================================================================="
    echo "STEP A: Copy this SSH Deploy Key to GitHub (Settings -> Deploy Keys):"
    echo "-------------------------------------------------------------------------"
    echo "$PUBLIC_KEY"
    echo "-------------------------------------------------------------------------"
    echo "STEP B: Add this Webhook info to GitHub (Settings -> Webhooks):"
    echo "  1. Payload URL:  https://${DOMAIN}/deploy.php"
    echo "  2. Content type: application/json"
    echo "  3. Secret:       ${SECRET_TOKEN}"
    echo "  4. Trigger:      Just the push event"
    echo "========================================================================="
    exit 0
fi

# Fallback error for invalid commands
echo "[-] Invalid command syntax. Use 'connect' or 'pull'."
exit 1
